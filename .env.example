# === Client-side (exposed in browser bundle via Vite) ===
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_BACKEND_URL=http://localhost:3001

# === Server-side only (used by api/ handlers and server/, NEVER exposed to the browser) ===

# Google Gemini API key — used for AI-powered natural language search.
# Get one from https://aistudio.google.com/apikey
# IMPORTANT: Rotate this key if it was ever committed or exposed in client code.
GEMINI_API_KEY=your_gemini_api_key

# Supabase service role key — used by the delivery-status API handler.
# Get it from Supabase Dashboard > Settings > API > service_role key.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
